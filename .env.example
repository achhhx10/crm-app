# CRM Prospection - Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# Database (Postgres - required)
# Local: postgresql://postgres@localhost:5433/crm
# Railway: use the DATABASE_URL of the Postgres addon
DATABASE_URL=postgresql://postgres@localhost:5433/crm

# Security
# Generate a strong random secret (64+ chars): openssl rand -base64 64
JWT_SECRET=change-me-to-a-strong-random-secret

# CORS
# In development: http://localhost:5173
# In production (split hosting): https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Frontend (Vercel) - API base URL, e.g. https://your-api.up.railway.app/api
# VITE_API_URL=https://your-api.up.railway.app/api

# Uploads (optional, defaults to OS tmp dir)
# UPLOAD_DIR=/tmp/crm-uploads
